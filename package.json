{
  "name": "desktop-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config ui/vite.config.ts",
    "build": "vite build --config ui/vite.config.ts",
    "check": "svelte-check --tsconfig ui/tsconfig.json",
    "test": "vitest run --config ui/vite.config.ts",
    "tauri": "tauri",
    "bindings": "cargo run --manifest-path src-tauri/Cargo.toml --bin gen-bindings"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.3",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "22.20.5",
    "jsdom": "30.1.2",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "dompurify": "3.4.17",
    "katex": "0.19.0",
    "marked": "18.1.1"
  }
}
